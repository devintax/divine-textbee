# =============================================================================
# TextBee SMS Gateway — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For local dev: cp .env.example .env (already done with generated secrets)
# For Coolify:   set these env vars in Coolify's UI (never commit .env)
# =============================================================================

# ── Application URLs ──────────────────────────────────────────────────────────
# Change per environment: http://localhost:3000 locally, https://sms.yourdomain.com in prod
APP_URL=http://localhost:3000

# ── Environment ──────────────────────────────────────────────────────────────
# Set to "production" on Coolify to disable the Swagger API docs page and
# public user registration. Swagger is always available in development for
# local debugging.
# Override with ENABLE_SWAGGER=true (force-enable in prod) or ENABLE_SWAGGER=false (force-disable in dev).
NODE_ENV=development

# Registration toggle. Set to false in production to prevent public signups.
# Existing accounts continue to work. Set to true temporarily in dev to create
# internal accounts, then set back.
ALLOW_REGISTRATION=true

# ── Ports ─────────────────────────────────────────────────────────────────────
# These map host ports to container ports. Change only if there's a conflict.
API_PORT=3001
WEB_PORT=3000
MONGO_PORT=27018
REDIS_PORT=6379
MONGO_EXPRESS_PORT=8081
ADMIN_DASHBOARD_PORT=4000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=adminUser
MONGO_ROOT_PASS=<generate: openssl rand -hex 32>

# ── JWT (API auth) ────────────────────────────────────────────────────────────
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_EXPIRATION=60d

# ── NextAuth (Web dashboard login) ────────────────────────────────────────────
AUTH_SECRET=<generate: openssl rand -hex 32>

# ── Firebase Cloud Messaging (Android push notifications) ─────────────────────
# Required for the Android app to receive commands from the server.
# Get these from your Firebase project -> Service accounts -> Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_C509_CERT_URL=

# ── Email (SMTP for user notifications) ───────────────────────────────────────
# Optional. Used for email notifications from the dashboard.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
ADMIN_EMAIL=

# ── SMS Queue (Redis) ─────────────────────────────────────────────────────────
# Set to true to use Redis-backed SMS queue for higher throughput.
USE_SMS_QUEUE=false

# ── Turnstile (Cloudflare CAPTCHA) ────────────────────────────────────────────
# Optional. Protects the web dashboard registration/login forms.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── App Version (for Android app update prompts) ──────────────────────────────
NEXT_PUBLIC_LATEST_APP_VERSION_CODE=17

# ── Webhook Delivery ──────────────────────────────────────────────────────────
# Optional tuning of webhook delivery behavior.
WEBHOOK_DELIVERY_TIMEOUT_MS=30000
WEBHOOK_AUTO_DISABLE_FAILURE_THRESHOLD=50
WEBHOOK_AUTO_DISABLE_LOOKBACK_DAYS=30
WEBHOOK_AUTO_DISABLE_MIN_FAILURE_RATE=0.50

# ── Admin Dashboard ──────────────────────────────────────────────────────────
ADMIN_DASHBOARD_PORT=4000
# Internal address of the gateway service — admin dashboard calls it server-side.
GATEWAY_ADMIN_URL=http://textbee-gateway:4001
GATEWAY_ADMIN_TOKEN=<openssl rand -hex 32>

# Single admin account for the operations console.
# To generate ADMIN_PASSWORD_HASH: `node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"`
# To generate SESSION_SECRET: `openssl rand -hex 32`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<bcrypt hash>
SESSION_SECRET=<openssl rand -hex 32>

# TextBee API base URL — points to textbee-api on the internal Docker network.
# On Coolify, the dashboard runs as a separate service; TEXTBEE_API_URL is the
# Coolify-internal service address (e.g., http://textbee-api:3001/api/v1).
TEXTBEE_API_URL=http://textbee-api:3001/api/v1
# API key generated from TextBee's dashboard or API. Must have SMS sending + device read access.
TEXTBEE_API_KEY=

# ── SMS Gateway ──────────────────────────────────────────────────────────────
GATEWAY_PORT=4001
# Generate: `openssl rand -hex 32`
GATEWAY_ADMIN_TOKEN=<openssl rand -hex 32>
