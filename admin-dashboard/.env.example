# ── Auth ──────────────────────────────────────────────────────────────────
# Single admin account for the internal operations console.
# Generate ADMIN_PASSWORD_HASH: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Generate SESSION_SECRET: openssl rand -hex 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=<bcrypt hash of your password>
SESSION_SECRET=<openssl rand -hex 32>

# ── TextBee API Connection ────────────────────────────────────────────────
# Points to TextBee over the internal Docker network.
# On Coolify, same pattern works via Coolify's internal DNS.
TEXTBEE_API_URL=http://textbee-api:3001/api/v1
TEXTBEE_API_KEY=<api-key-from-textbee>

# ── SMS Gateway Admin API ──────────────────────────────────────────────────
GATEWAY_ADMIN_URL=http://textbee-gateway:4001
GATEWAY_ADMIN_TOKEN=<gateway admin bearer token>
